# Supabase — crie um projeto em https://supabase.com e rode supabase/schema.sql
# no SQL editor do projeto antes de preencher essas variáveis.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — Settings > API. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — usado para avisar o dono por e-mail quando a cápsula abre.
# Crie uma conta em https://resend.com e gere uma API key.
RESEND_API_KEY=

# Segredo usado para autenticar o cron job (app/api/cron/checar-aberturas).
# Gere uma string aleatória e configure a mesma no painel da Vercel
# (Project Settings > Environment Variables) — a Vercel envia esse valor
# automaticamente no header Authorization para crons configurados em vercel.json.
CRON_SECRET=

# URL pública DESTE aplicativo em produção (sem barra no final), ex:
# https://capsula-app.vercel.app. Usado para montar as URLs de retorno e
# de notificação do Mercado Pago, e o link público dos álbuns (/c/[slug]).
NEXT_PUBLIC_SITE_URL=

# Mercado Pago — Access Token de produção/teste em
# https://www.mercadopago.com.br/developers/panel/app
# Nunca expor no navegador.
MERCADOPAGO_ACCESS_TOKEN=
