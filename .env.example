# Supabase — crie um projeto em https://supabase.com e rode supabase/schema.sql
# no SQL editor do projeto antes de preencher essas variáveis.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — Settings > API. Nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — usado para avisar o dono por e-mail quando a cápsula abre.
# Crie uma conta em https://resend.com e gere uma API key.
RESEND_API_KEY=

# Segredo usado para autenticar o cron job (app/api/cron/checar-aberturas).
# Gere uma string aleatória e configure a mesma no painel da Vercel
# (Project Settings > Environment Variables) — a Vercel envia esse valor
# automaticamente no header Authorization para crons configurados em vercel.json.
CRON_SECRET=

# URL pública do site em produção (sem barra no final), usada para montar o
# link de acesso enviado por e-mail após a compra.
NEXT_PUBLIC_SITE_URL=

# Link de checkout da Lastlink do seu produto (ex: https://lastlink.com/p/SEU_PRODUTO).
# Usado no botão de compra da landing page.
NEXT_PUBLIC_CHECKOUT_URL=

# Segredo compartilhado pra validar o webhook da Lastlink em
# app/api/webhooks/lastlink. Gere uma string aleatória e configure a mesma
# coisa na URL do webhook no painel da Lastlink, como ?secret=SEU_SEGREDO
# (ou no header x-webhook-secret, se a Lastlink permitir headers customizados).
# A documentação oficial da Lastlink bloqueou acesso automático ao ser
# consultada — confirme o nome exato dos campos do payload e o mecanismo de
# autenticação disponível direto no painel deles antes de ativar em produção.
LASTLINK_WEBHOOK_SECRET=
